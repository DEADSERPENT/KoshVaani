APP_NAME=KoshVaani
# development | test | production. Production refuses to start if any development shortcut below is on.
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# memory = mongomock + fakeredis (no external services); mongo = real MongoDB + Redis
STORAGE_BACKEND=memory
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=koshvaani
REDIS_URL=redis://localhost:6379/0

# Encrypts personal data (name, phone, email) at rest. Generate once and keep it secret and backed up:
#   python -c "from app.core.crypto import generate_key; print(generate_key())"   (run inside backend/)
# Losing it makes stored customer data unreadable. Empty in development = throwaway key per run.
DATA_ENCRYPTION_KEY=

# How customers sign in: password (phone number + password, no SMS) or otp (a texted code through your SMS gateway).
AUTH_MODE=password
# Only for AUTH_MODE=otp: the code is POSTed as JSON to your SMS gateway. It is never shown on screen outside the automated tests.
OTP_PROVIDER=http
SMS_URL=https://your-sms-gateway.example/send
# SMS_AUTH_HEADER_NAME=Authorization
SMS_AUTH_HEADER_VALUE=Bearer <key>
SMS_BODY_TEMPLATE={"to": "{phone}", "message": "Your KoshVaani code is {code}. Do not share it."}

# Must stay false: it would return the login code in the API response (automated tests only).
ECHO_DEV_OTP=false
# Operator console accounts. Create real ones with: python scripts/create_operator.py
# Optional first-admin bootstrap (only used while no operator exists; remove after first start):
# BOOTSTRAP_OPERATOR_USERNAME=
# BOOTSTRAP_OPERATOR_PASSWORD=
OPERATOR_SESSION_SECONDS=3600

LLM_PROVIDER=rules
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Speech: mock needs no key. Free keys: Groq (console.groq.com) for STT, Deepgram (console.deepgram.com) for TTS.
STT_PROVIDER=mock
TTS_PROVIDER=mock
GROQ_API_KEY=
DEEPGRAM_API_KEY=
